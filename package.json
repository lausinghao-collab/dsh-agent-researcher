{
  "name": "dsh-agent-researcher",
  "version": "1.3.0",
  "description": "资料搜集员：批量检索、来源台账与引用校验、本地文档抽取、报告模板、CSV/HTML 导出、多风格图表，输出可核实的中文调研报告（DeepSeek Harness 自定义 Agent）",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "agent",
    "agent-preset",
    "cordis",
    "research",
    "中文"
  ],
  "license": "MIT",
  "author": "lausinghao-collab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lausinghao-collab/dsh-agent-researcher.git"
  },
  "homepage": "https://github.com/lausinghao-collab/dsh-agent-researcher#readme",
  "bugs": {
    "url": "https://github.com/lausinghao-collab/dsh-agent-researcher/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test test/charts.test.mjs test/sources.test.mjs test/search.test.mjs test/documents.test.mjs test/export.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./charts": "./lib/charts.js",
    "./sources": "./lib/sources.js",
    "./search": "./lib/search.js",
    "./documents": "./lib/documents.js",
    "./table": "./lib/table.js",
    "./templates": "./lib/templates.js",
    "./html": "./lib/html.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
